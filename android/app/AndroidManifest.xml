<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="app.sol">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Nearby (LAN discovery): receive multicast beacons while the node runs (NodeService). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Nearby over Wi-Fi Direct (WifiDirect): asked for only when the person turns it on.
         Android 13+ needs NEARBY_WIFI_DEVICES (Sol never derives a location from it); older
         versions need fine location for any Wi-Fi scan. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ConnectActivity hides other apps' overlays while it asks for approval. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- Calendar sync (CalendarSync): asked for only when the person turns it on in Sol. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <!-- Package visibility (Android 11+) for launcher apps only: the Apps grid opens a connected
         app (SolWeb Bridge.openApp) with getLaunchIntentForPackage, which needs to see it. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- allowBackup=false: the device key must not reach cloud backups. extractNativeLibs=true:
         libsol.so is a program and must exist as a file to be executed. -->
    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:debuggable="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sol" android:host="join" />
                <data android:scheme="sol" android:host="pair" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- One Sol app full screen in its own task (sol-app://<id>): one recents entry per app. -->
        <activity
            android:name=".AppActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|uiMode"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:documentLaunchMode="intoExisting"
            android:taskAffinity="" />

        <!-- Launcher shortcuts land here and hand over to AppActivity without restarting its task. -->
        <activity
            android:name=".ShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Another app asking to become a Sol app (M5): startActivityForResult only, approval
             screen, then its token back (android/README.md "For Android developers"). -->
        <activity
            android:name=".ConnectActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|uiMode">
            <intent-filter>
                <action android:name="app.sol.action.CONNECT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Approve / Deny / Dismiss on inbox notifications. -->
        <receiver
            android:name=".InboxReceiver"
            android:exported="false" />

        <service
            android:name=".NodeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps this device's Sol node running so it stays reachable by the devices it is paired with" />
        </service>

        <!-- The synced folder as "Sol" in the system Files app and file pickers (DriveProvider). -->
        <provider
            android:name=".DriveProvider"
            android:authorities="app.sol.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- The local "app.sol" account and its calendar sync adapter (CalendarSync). -->
        <service
            android:name=".CalendarSync$AuthService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
        </service>
        <service
            android:name=".CalendarSync$SyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/syncadapter" />
        </service>

        <!-- Files handed to a viewer app (a PDF preview), read-only, by per-intent grant only. -->
        <provider
            android:name=".OpenProvider"
            android:authorities="app.sol.open"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
